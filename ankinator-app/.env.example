# ─── Provedor de geração de questões ───────────────────────────────
# 'cli' = usa o Claude Code (`claude` CLI) com a SUA ASSINATURA Pro/Max,
#         sem API key e sem custo por token (padrão).
# 'api' = usa a API Anthropic com ANTHROPIC_API_KEY (cobrança por token).
ANKINATOR_PROVIDER=cli

# Modelo quando ANKINATOR_PROVIDER=cli (alias 'sonnet'/'opus'/'haiku' ou id completo)
ANKINATOR_CLI_MODEL=sonnet

# Caminho do binário do Claude Code (se não estiver no PATH como "claude")
# ANKINATOR_CLAUDE_BIN=claude

# ─── Enriquecimento ORQUESTRADO (Destino #4 / Phase 5) — opt-in ──────
# Liga o subagent `ankinator-orchestrator` (roda `claude -p --agent` da raiz
# do repo com a tool Task) como o cérebro que decide por-card quais estágios
# rodar e delega aos 4 subagents. Em QUALQUER falha cai p/ o pipeline
# determinístico (enrichAll). Default OFF (byte-equivalente). Validar AO VIVO.
# ANKINATOR_ORCHESTRATED=1
# Só se a validação ao vivo mostrar bloqueio de permissão num subagent:
# ANKINATOR_ORCHESTRATED_BYPASS=1
# Raiz do repo (onde vive .claude/agents/); default = auto-resolvido.
# ANKINATOR_PROJECT_ROOT=
# Timeout da orquestração multi-turn (ms; default 600000).
# ANKINATOR_ORCHESTRATOR_TIMEOUT_MS=600000

# ─── Loader LangChain (Destino #5) ──────────────────────────────────
# Interpretador Python do venv com langchain-opendataloader-pdf (requer Java 11+).
# Com esta var + pacote importável, o loader 'langchain' é auto-selecionado.
# Setup: python3 -m venv ~/.venvs/odl && ~/.venvs/odl/bin/pip install -r tools/requirements.txt
# ANKINATOR_LANGCHAIN_PYTHON=/home/USER/.venvs/odl/bin/python3
# Forçar/desligar explicitamente: node | langchain
# ANKINATOR_PDF_LOADER=langchain

# ─── Opção: provedor 'api' ──────────────────────────────────────────
# Necessário SOMENTE se ANKINATOR_PROVIDER=api
ANTHROPIC_API_KEY=
# Modelo da API (id completo)
ANKINATOR_MODEL=claude-sonnet-4-6

# ─── Servidor / Anki ────────────────────────────────────────────────
# Porta do servidor de API
PORT=8787

# URL do AnkiConnect (add-on do Anki aberto)
ANKICONNECT_URL=http://127.0.0.1:8765

# ─── OCR (opcional) ─────────────────────────────────────────────────
# Python com o backend híbrido do OpenDataLoader, para PDFs escaneados.
# Vazio = só modo local (Java) sem OCR.
ODL_PYTHON=

# ─── Loader markitdown (opt-in, SEM Java) ────────────────────────────
# Loader de PDF alternativo sem dependência de Java.
# Produz um blob Markdown único por documento (numPages=1 — limitação documentada).
# Para PDFs escaneados sem camada de texto, use o caminho OCR acima (ODL_PYTHON).
#
# Setup do venv dedicado (NÃO instalar no venv langchain/OCR):
#   python3 -m venv ~/.venvs/markitdown          (Python >=3.10)
#   ~/.venvs/markitdown/bin/pip install -r tools/requirements-markitdown.txt
#
# NOTA: a validação ao vivo (pip install em venv real + extrair PDF via markitdown)
# é um PASSO HUMANO PENDENTE — checkpoint T-k3b-SC. Verifique o pacote em
# https://pypi.org/project/markitdown/ antes do pip install.
ANKINATOR_MARKITDOWN_PYTHON=
# Ativar o loader markitdown (deixar comentado = default node intocado):
# ANKINATOR_PDF_LOADER=markitdown

# ─── Scaffold turbovec (busca vetorial — dedup semântico FUTURO) ─────
# Fundação para dedup semântico por embeddings — NÃO plugado no pipeline.
# O dedup Jaccard atual (deck-organizer/existing-deck) permanece intocado.
# Veja a fase futura "dedup semântico por embeddings" no ROADMAP.
#
# Setup do venv dedicado:
#   python3 -m venv ~/.venvs/turbovec             (Python >=3.9)
#   ~/.venvs/turbovec/bin/pip install -r tools/requirements-turbovec.txt
#
# NOTA: a validação ao vivo (pip install do wheel turbovec + rodar smoke) é um
# PASSO HUMANO PENDENTE. Verifique o pacote em https://pypi.org/project/turbovec/
# e confirme a wheel linux x86_64 antes do pip install.
ANKINATOR_TURBOVEC_PYTHON=
