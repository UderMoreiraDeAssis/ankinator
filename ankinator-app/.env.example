# ─── Provedor de geração de questões ───────────────────────────────
# 'cli' = usa o Claude Code (`claude` CLI) com a SUA ASSINATURA Pro/Max,
#         sem API key e sem custo por token (padrão).
# 'api' = usa a API Anthropic com ANTHROPIC_API_KEY (cobrança por token).
ANKINATOR_PROVIDER=cli

# Modelo quando ANKINATOR_PROVIDER=cli (alias 'sonnet'/'opus'/'haiku' ou id completo)
ANKINATOR_CLI_MODEL=sonnet

# Caminho do binário do Claude Code (se não estiver no PATH como "claude")
# ANKINATOR_CLAUDE_BIN=claude

# ─── Opção: provedor 'api' ──────────────────────────────────────────
# Necessário SOMENTE se ANKINATOR_PROVIDER=api
ANTHROPIC_API_KEY=
# Modelo da API (id completo)
ANKINATOR_MODEL=claude-sonnet-4-6

# ─── Servidor / Anki ────────────────────────────────────────────────
# Porta do servidor de API
PORT=8787

# URL do AnkiConnect (add-on do Anki aberto)
ANKICONNECT_URL=http://127.0.0.1:8765

# ─── OCR (opcional) ─────────────────────────────────────────────────
# Python com o backend híbrido do OpenDataLoader, para PDFs escaneados.
# Vazio = só modo local (Java) sem OCR.
ODL_PYTHON=
