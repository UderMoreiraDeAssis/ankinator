# Chave da API da Anthropic (necessária para gerar questões com o Claude)
ANTHROPIC_API_KEY=

# Modelo do Claude usado na geração de questões
ANKINATOR_MODEL=claude-sonnet-4-6

# Porta do servidor de API
PORT=8787

# URL do AnkiConnect (add-on do Anki aberto). Padrão do add-on:
ANKICONNECT_URL=http://127.0.0.1:8765

# Caminho do executável Python com o backend híbrido do OpenDataLoader (OCR).
# Deixe vazio para usar apenas o modo local (Java) sem OCR.
ODL_PYTHON=
