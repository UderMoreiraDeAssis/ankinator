{
  "name": "@ankinator/server",
  "version": "1.0.0",
  "private": true,
  "description": "API do Ankinator: extração de PDF (OpenDataLoader), geração de questões (Claude) e exportação (CSV/AnkiConnect)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "tsx src/scripts/smoke-loader.ts",
    "test": "vitest run",
    "test:guard": "tsx src/scripts/guard-enrich.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@opendataloader/pdf": "^2.4.7",
    "csv-stringify": "^6.5.2",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
